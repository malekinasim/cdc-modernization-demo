# ORDER APP  Settings
ORDER_DB=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass
ORDER_DB_PORT=5432
ORDER_APP_PORT=8081

# SHIPPING APP  Settings
SHIPPING_DB=ship_db
SHIPPING_DB_USER=shp_user
SHIPPING_DB_PASSWORD=ship_pass
SHIPPING_DB_PORT=5434
SHIPPING_APP_PORT=8084

# READ APP  Settings
READ_MONGO_ROOT_USER=admin
READ_MONGO_ROOT_PASSWORD=admin
READ_MONGO_DB_NAME=myappdb
READ_MONGO_PORT=27017
READ_APP_PORT=8083
SPRING_DATA_MONGODB_URI=mongodb://${READ_MONGO_ROOT_USER}:${READ_MONGO_ROOT_PASSWORD}@mongodb:${READ_MONGO_PORT}/${READ_MONGO_DB_NAME}?authSource=admin
MIDDLEWARE_APP_PORT=8080

# Mongo Express Settings
READ_MONGO_EXPRESS_PORT=8082
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local_admin_password
PGADMIN_PORT=5050

# Kafka Settings
KAFKA_NODE_ID=1
KAFKA_VERSION=4.0.0
CONFLUENT_VERSION=8.4.0
KAFKA_REPLICATION_FACTOR=1
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
SCHEMA_REGISTRY_PORT=8086

# Kafka Connect & Debezium
CONNECT_GROUP_ID=debezium-cluster
CONNECT_CONFIG_TOPIC=connect_configs
CONNECT_OFFSET_TOPIC=connect_offsets
CONNECT_STATUS_TOPIC=connect_statuses
KAFKA_CONNECT_PORT=8087
